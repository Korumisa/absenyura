# ============================================================================
# DATABASE — PILIH SALAH SATU (uncomment baris OPSI yang dipilih, COMMENT opsi lain)
# ============================================================================
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ ⭐ OPSI A: SUPABASE REMOTE (REKOMENDASI — 1.000+ user / tanpa DBA)        │
# │    Database managed Supabase via pooler (Supavisor)                      │
# └──────────────────────────────────────────────────────────────────────────┘
# VPS (1 proses persisten): Session pooler port 5432, tanpa pgbouncer, connection_limit=10.
DATABASE_URL="postgresql://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:5432/postgres?connection_limit=10&connect_timeout=5&pool_timeout=10"
# Vercel/serverless: Transaction pooler port 6543 + pgbouncer=true, connection_limit kecil.
# DATABASE_URL="postgresql://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&statement_cache_size=0&connect_timeout=5&pool_timeout=5"
# Migrasi Prisma saja (direct, port 5432, NON-pooler) — HANYA untuk prisma migrate deploy
DIRECT_URL="postgresql://postgres.[ref]:[pwd]@db.[ref].supabase.co:5432/postgres"
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  🔥 OPSI B: POSTGRESQL 16 SELF-HOST 1 VPS (Budget strict KVM 2 8 GB)    │
# │     Local Unix socket + PgBouncer pooler port 6432 + connection_limit=3 │
# │     Jalankan deploy/selfhost/prisma-prereq.sql SEBELUM set ini.         │
# │     Ganti <HMSDP_APP_PASSWORD> SAMA PERSIS dengan password role app.   │
# └──────────────────────────────────────────────────────────────────────────┘
# DATABASE_URL="postgresql://hmsdp_app:<HMSDP_APP_PASSWORD>@127.0.0.1:6432/hmsdp?host=/var/run/postgresql&pgbouncer=true&connection_limit=3&statement_cache_size=0&connect_timeout=5&pool_timeout=5&schema=public"
# DIRECT_URL="postgresql://hmsdp_app:<HMSDP_APP_PASSWORD>@127.0.0.1:5432/hmsdp?host=/var/run/postgresql&connect_timeout=10&schema=public"

# Notes umum (kedua opsi):
# - Development lokal: BISA pakai DIRECT_URL sebagai DATABASE_URL (tanpa pgbouncer)
# - Keep connection_limit explicit. Self-host: jangan > 5 (OOM Postgres 8 GB shared!).
# - connect_timeout dicap 5 detik; pool_timeout dicap 5 detik (6543) / 10 detik (session pooler).
# - Apply migrations pakai DIRECT_URL sebelum start app; `prisma generate` TIDAK menjalankan migration.

JWT_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"
ATTENDANCE_PROOF_SECRET="change_me_use_32_plus_random_bytes"

CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

SEED_SECRET="change_me_change_me_change_me_change_me"

# Health / internal ops — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET="change_me_before_deploy"

# Cron eksternal (cron-job.org, GitHub Actions) — generate random 32+ byte hex
CRON_SECRET="change_me"
# Configure APP_URL, CRON_SECRET, ALERT_WEBHOOK_URL as GitHub Actions secrets for availability monitoring.
# Use an HTTPS Slack-compatible webhook; never expose it through VITE_* variables.
APP_URL="https://your-app-domain.example.com"
# VITE_APP_URL harus SAMA dengan APP_URL — digunakan di React client untuk SEO canonical, OG tags, JSON-LD.
VITE_APP_URL="https://your-app-domain.example.com"
FRONTEND_URL="https://your-app-domain.example.com"
ALERT_WEBHOOK_URL=""

SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_PASSWORD="StrongPasswordHere"
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_NIM_NIP="198001012005011001"

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="StrongPasswordHere"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_NIM_NIP="198001012005011002"

SEED_CONTENT_ADMIN_EMAIL="content@example.com"
SEED_CONTENT_ADMIN_PASSWORD="StrongPasswordHere"
SEED_CONTENT_ADMIN_NAME="Content Admin"
SEED_CONTENT_ADMIN_NIM_NIP="198001012005011003"

SEED_PUBLIC_SITE="0"
SEED_PUBLIC_ORG_NAME=""
SEED_PUBLIC_CAMPUS_NAME=""
SEED_PUBLIC_KABINET_NAME=""
SEED_PUBLIC_KABINET_PERIOD=""
SEED_PUBLIC_LOGO_LIGHT_URL=""
SEED_PUBLIC_LOGO_DARK_URL=""
SEED_PUBLIC_PRIMARY_COLOR="#2563eb"
SEED_PUBLIC_INSTAGRAM_URL=""
SEED_PUBLIC_TIKTOK_URL=""
SEED_PUBLIC_YOUTUBE_URL=""

VITE_API_PROXY_TARGET="http://localhost:3001"
VITE_API_BASE_URL="/api"
VITE_PROXY_LOG="0"
# Set to 443 only when the dev server is behind an HTTPS reverse proxy.
VITE_HMR_CLIENT_PORT=""
VITE_DEV_BYPASS_AUTH="0"
FRONTEND_URL="https://your-app-domain.vercel.app"
CORS_ORIGINS="https://your-app-domain.vercel.app"
PORT="3001"
