# ===================================================================
# Template Environment Production — Hostinger VPS / VPS umum
# Copy ke /var/www/hmsdp/.env LALU isi semua nilai.
# JANGAN commit file ini ke git (.gitignore sudah melindungi .env).
# ===================================================================

# ====== Node Runtime ======
NODE_ENV=production
PORT=3001

# ====== Domain & CORS ======
# Domain FULL dengan https:// tanpa trailing slash
APP_URL=https://your-domain.com
# VITE_APP_URL HARUS SAMA PERSIS dengan APP_URL — di-bundle ke React saat build
VITE_APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
# Pisahkan dengan koma jika ada beberapa origin (misal www + non-www)
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
# Script /_vercel/insights hanya ada di Vercel — matikan di VPS.
VITE_VERCEL_ANALYTICS=false

# ====== Database (Supabase Pooler / Postgres) ======
# Production VPS: pakai Supabase transaction pooler (port 6543) dengan pgbouncer.
# connection_limit DIATUR OLEH normalizeDatabaseUrl() secara otomatis.
DATABASE_URL=postgresql://postgres.project_ref:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&statement_cache_size=0&connect_timeout=5&pool_timeout=5
# DIRECT_URL digunakan HANYA untuk prisma migrate deploy (port 5432 non-pooler)
DIRECT_URL=postgresql://postgres.project_ref:PASSWORD@db.project_ref.supabase.co:5432/postgres
# Backup scripts/vps-backup.sh — Supabase Session pooler port 5432
BACKUP_DATABASE_URL="postgresql://postgres.project_ref:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ====== Secrets (WAJIB ROTASI, minimal 32 byte random) ======
# Generate 1 secret (32 byte hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=________________________________________________________________
JWT_REFRESH_SECRET=________________________________________________________________
ATTENDANCE_PROOF_SECRET=________________________________________________________________
SEED_SECRET=________________________________________________________________
# Internal ops / health endpoints — guard dari akses publik
INTERNAL_SECRET=________________________________________________________________
# Cron trigger — guard dari akses publik di /api/cron/*
CRON_SECRET=________________________________________________________________

# ====== Storage: Cloudinary (DISARANKAN) ======
# Jika dikosongkan, foto akan disimpan ke ./uploads lokal (lihat DEPLOY_VPS_HOSTINGER.md persistent storage)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ====== Opsional ======
# Super admin SEED (hanya aktif jika SEED_SECRET di-set + panggil endpoint dengan header X-Seed-Secret)
SEED_SUPER_ADMIN_EMAIL=superadmin@your-domain.com
SEED_SUPER_ADMIN_PASSWORD=____________________________
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_NIM_NIP=198001012005011001

SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=____________________________
SEED_ADMIN_NAME=Admin
SEED_ADMIN_NIM_NIP=198001012005011002

SEED_CONTENT_ADMIN_EMAIL=content@your-domain.com
SEED_CONTENT_ADMIN_PASSWORD=____________________________
SEED_CONTENT_ADMIN_NAME=Content Admin
SEED_CONTENT_ADMIN_NIM_NIP=198001012005011003

SEED_PUBLIC_SITE=0
SEED_PUBLIC_ORG_NAME=HM SDP Undiksha
SEED_PUBLIC_CAMPUS_NAME=Universitas Pendidikan Ganesha
SEED_PUBLIC_KABINET_NAME=
SEED_PUBLIC_KABINET_PERIOD=
SEED_PUBLIC_LOGO_LIGHT_URL=
SEED_PUBLIC_LOGO_DARK_URL=
SEED_PUBLIC_PRIMARY_COLOR=#2563eb
SEED_PUBLIC_INSTAGRAM_URL=
SEED_PUBLIC_TIKTOK_URL=
SEED_PUBLIC_YOUTUBE_URL=

# Slack-compatible webhook untuk alert availability monitoring
ALERT_WEBHOOK_URL=
