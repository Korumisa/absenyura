# ===========================================================================
# Environment Production Template — 1 VPS DUAL PURPOSE (App + PostgreSQL 16 Self-Host)
# HOSTINGER VPS KVM2 (8 GB RAM / 2 vCPU / 100 GB NVMe)
# ===========================================================================
# Copy to /var/www/hmsdp/.env  LALU isi semua nilai.
#     cp deploy/.env.vps-selfhost.example /var/www/hmsdp/.env
#     chmod 600 /var/www/hmsdp/.env   (HARUS 600 — hanya owner deploy boleh baca)
# ===========================================================================

# ====== 1. Node Runtime ======
NODE_ENV=production
# Internal Node.js app bind ke 127.0.0.1 HANYA. Nginx reverse proxy dari 0.0.0.0:443
PORT=3001
HOST=127.0.0.1
# Limit heap Node.js agar TIDAK melebihi 1536 MB agar Postgres (sisa ~3 GB aman)
NODE_OPTIONS="--max-old-space-size=1536"

# ====== 2. Domain & CORS (SELF-HOST = domain Anda sendiri) ======
APP_URL=https://your-domain.com
VITE_APP_URL=https://your-domain.com     # HARUS SAMA DENGAN APP_URL (di-bundle build Vite!)
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
# Script /_vercel/insights hanya ada di Vercel — matikan di VPS.
VITE_VERCEL_ANALYTICS=false

# ====== 3. DATABASE — PostgreSQL 16 LOCAL VPS (Self-Host, BUKAN Supabase) ======
# ---------------------------------------------------------------------------
# PENTING: GANTI <HMSDP_APP_PASSWORD> SAMA PERSIS dengan password yang Anda
#          set di deploy/prisma-selfhost-prereq.sql pada CREATE ROLE hmsdp_app.
# ---------------------------------------------------------------------------
#
# (a) DATABASE_URL = pakai PgBouncer pooler (localhost port 6432) +
#                    Unix domain socket (/var/run/postgresql) bypass TCP.
#                    connection_limit=3 — HARD LIMIT untuk 8 GB shared.
DATABASE_URL=postgresql://hmsdp_app:<HMSDP_APP_PASSWORD>@127.0.0.1:6432/hmsdp?host=/var/run/postgresql&pgbouncer=true&connection_limit=3&statement_cache_size=0&connect_timeout=5&pool_timeout=5&schema=public
#
# (b) DIRECT_URL = pakai direct Postgres connection port 5432 (TANPA PgBouncer).
#                  DIGUNAKAN HANYA untuk `prisma migrate deploy` DAN `prisma db execute`.
#                  JANGAN dipakai runtime app — HABISKAN koneksi Postgres!
DIRECT_URL=postgresql://hmsdp_app:<HMSDP_APP_PASSWORD>@127.0.0.1:5432/hmsdp?host=/var/run/postgresql&connect_timeout=10&schema=public

# ====== 4. Secrets — WAJIB ROTASI, masing-masing 32 byte hex RANDOM ======
# Generate 1 secret (jalankan 6x di node CLI):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=________________________________________________________________
JWT_REFRESH_SECRET=________________________________________________________________
ATTENDANCE_PROOF_SECRET=________________________________________________________________
SEED_SECRET=________________________________________________________________
INTERNAL_SECRET=________________________________________________________________
# X-Cron-Secret header untuk /api/cron/* trigger — JANGAN share ke publik
CRON_SECRET=________________________________________________________________

# ====== 5. Storage Foto Bukti Absensi ======
# DISARANKAN ISI — untuk hindari ./uploads I/O contention dengan Postgres WAL.
# Jika dikosongkan: fallback ./uploads persistent symlink.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ====== 6. Seed Super Admin / Admin (SEED_SECRET harus diisi) ======
SEED_SUPER_ADMIN_EMAIL=superadmin@your-domain.com
SEED_SUPER_ADMIN_PASSWORD=____________________________
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_NIM_NIP=198001012005011001

SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=____________________________
SEED_ADMIN_NAME=Admin Akdemik
SEED_ADMIN_NIM_NIP=198001012005011002

SEED_CONTENT_ADMIN_EMAIL=content@your-domain.com
SEED_CONTENT_ADMIN_PASSWORD=____________________________
SEED_CONTENT_ADMIN_NAME=Content Admin CMS
SEED_CONTENT_ADMIN_NIM_NIP=198001012005011003

# ====== 7. CMS Public Site ======
SEED_PUBLIC_SITE=0
SEED_PUBLIC_ORG_NAME=HM SDP Undiksha
SEED_PUBLIC_CAMPUS_NAME=Universitas Pendidikan Ganesha
SEED_PUBLIC_KABINET_NAME=
SEED_PUBLIC_KABINET_PERIOD=
SEED_PUBLIC_LOGO_LIGHT_URL=
SEED_PUBLIC_LOGO_DARK_URL=
SEED_PUBLIC_PRIMARY_COLOR=#2563eb
SEED_PUBLIC_INSTAGRAM_URL=
SEED_PUBLIC_TIKTOK_URL=
SEED_PUBLIC_YOUTUBE_URL=

# ====== 8. Monitoring Alert (Slack / Discord Webhook) ======
# Opsional. Jika diisi: script vps-backup.sh + availability monitoring
# kirim alert FAIL ke webhook Slack-compatible ini.
ALERT_WEBHOOK_URL=

# ====== 9. Backup Configuration (rclone) ======
# Nama rclone REMOTE (lihat `rclone config show`) — default: b2remote
BACKUP_RCLONE_REMOTE=b2remote
# Nama bucket / path di remote object storage (TANPA leading / trailing slash)
BACKUP_RCLONE_PATH=my-b2-bucket-name/hmsdp-db-backups
# Retention: delete backup lebih tua dari 30 hari. Ubah jika perlu.
BACKUP_RETAIN_DAYS=30
# Path log file backup script
BACKUP_LOG_FILE=/var/log/hmsdp/backup.log
