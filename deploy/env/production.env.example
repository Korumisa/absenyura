# ==============================================================================
# .env PRODUCTION — HYBRID: VPS (APP) + SUPABASE (DATABASE)
# Panduan lengkap: deploy/README.md langkah 5.
#
# CARA PAKAI:
#   1. Setelah deploy/scripts/install-stack.sh selesai + reboot.
#   2. SSH deploy@<IP> — lalu:
#      sudo cp /var/www/hmsdp/repo/deploy/env/production.env.example /var/www/hmsdp/.env
#      sudo chmod 600 /var/www/hmsdp/.env
#      sudo chown deploy:deploy /var/www/hmsdp/.env
#      nano /var/www/hmsdp/.env
#   3. Isi SEMUA slot "____". Nilai bisa disalin dari Vercel → Project → Settings →
#      Environment Variables (Production) supaya sesi login & bukti absen tetap valid.
#   4. Simpan Ctrl+O Enter, keluar Ctrl+X.
#
# Generate secret baru (32 byte hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# A. RUNTIME (PORT/HOST/TZ juga di-set oleh ecosystem.config.cjs)
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Scheduler sesi/auto-alfa/cleanup berjalan di proses ini. Set false hanya untuk salinan
# staging/uji yang memakai DB yang sama (cukup 1 proses per database).
CRON_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# B. DOMAIN — https:// tanpa trailing slash
#    VITE_* di-bundle SAAT BUILD → ubah nilai = wajib `npm run build:vps` ulang.
# ─────────────────────────────────────────────────────────────────────────────
#    Ganti domain = ubah 4 baris ini + server_name nginx, lalu build ulang.
APP_URL=https://hmsdp.me
VITE_APP_URL=https://hmsdp.me
FRONTEND_URL=https://hmsdp.me
CORS_ORIGINS=https://hmsdp.me,https://www.hmsdp.me
# Script /_vercel/insights hanya ada di Vercel — matikan di VPS.
VITE_VERCEL_ANALYTICS=false

# ─────────────────────────────────────────────────────────────────────────────
# C. SUPABASE (Project Settings → Database → Connection string)
# ─────────────────────────────────────────────────────────────────────────────
# Runtime app: SESSION pooler port 5432 (host pooler, bukan db.<ref>), TANPA pgbouncer=true.
#   VPS = 1 proses Node persisten → koneksi dipakai ulang, prepared statement tetap aktif
#   (±2,5x lebih cepat per query dibanding transaction pooler 6543 dari VPS Indonesia).
#   connection_limit=10: Supabase Free membatasi klien session mode ±15 (pool size);
#   sisakan slot untuk migrate/backup. pool_timeout otomatis dibatasi 10 detik.
# WAJIB pakai tanda kutip (ada karakter &).
DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?connection_limit=10&connect_timeout=5&pool_timeout=10"
# Hanya untuk `npm run db:migrate:deploy`.
DIRECT_URL="postgresql://postgres:<password>@db.<project_ref>.supabase.co:5432/postgres"
# Backup pg_dump (deploy/scripts/backup.sh): Session pooler port 5432 (IPv4, mendukung pg_dump).
BACKUP_DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# D. SECRET — SALIN DARI VERCEL (jangan generate baru saat cutover):
#    JWT_* baru = semua user ter-logout. ATTENDANCE_PROOF_SECRET baru = challenge
#    absen yang sedang berjalan gagal diverifikasi.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=________________________________________________________________
JWT_REFRESH_SECRET=________________________________________________________________
ATTENDANCE_PROOF_SECRET=________________________________________________________________
INTERNAL_SECRET=________________________________________________________________
CRON_SECRET=________________________________________________________________
SEED_SECRET=________________________________________________________________

# ─────────────────────────────────────────────────────────────────────────────
# E. CLOUDINARY — foto bukti absen, dokumen izin, aset CMS.
#    Kosong = disimpan ke ./uploads lokal (symlink ke /var/www/hmsdp/uploads).
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─────────────────────────────────────────────────────────────────────────────
# F. BACKUP → Backblaze B2 via rclone (lihat deploy/README.md langkah 2)
#    Supabase Free TIDAK punya backup otomatis — bagian ini WAJIB untuk Free plan.
#    pg_dump harus versi >= versi Postgres Supabase (cek: Dashboard → Settings → Infrastructure).
# ─────────────────────────────────────────────────────────────────────────────
BACKUP_RCLONE_REMOTE=b2remote
BACKUP_RCLONE_PATH=hmsdp-backup-free-uniku/hmsdp-db-backups
BACKUP_RETAIN_DAYS=30
BACKUP_LOG_FILE=/var/www/hmsdp/logs/backup.log

# Slack/Discord-compatible webhook untuk alert backup & availability (opsional)
ALERT_WEBHOOK_URL=
