# ============================================================
# Apache2 virtual host — Hostinger VPS (Ubuntu 22.04)
# Pakai ini HANYA jika stack server Anda adalah Apache (bukan Nginx).
# Sebagian besar Node.js deploy lebih stabil pakai Nginx, tapi Apache tetap OK.
#
# Simpan: /etc/apache2/sites-available/hmsdp.conf
# Aktifkan:
#   sudo a2enmod proxy proxy_http proxy_wstunnel rewrite headers ssl
#   sudo a2ensite hmsdp
#   sudo apache2ctl configtest && sudo systemctl reload apache2
# SSL via Let's Encrypt: sudo certbot --apache -d your-domain.com
# ============================================================

<VirtualHost *:80>
    ServerName  your-domain.com
    ServerAlias www.your-domain.com
    ServerAdmin admin@your-domain.com

    # Redirect HTTP -> HTTPS (uncomment setelah certbot selesai)
    # RewriteEngine On
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [R=301,L]

    LimitRequestBody 20971520
    Timeout 120
    ProxyTimeout 120

    ProxyRequests Off
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "http"
    RequestHeader set X-Forwarded-Port "80"

    <Proxy *>
        Require all granted
    </Proxy>

    ProxyPass        / http://127.0.0.1:3001/ timeout=120 Keepalive=On
    ProxyPassReverse / http://127.0.0.1:3001/

    ErrorLog ${APACHE_LOG_DIR}/hmsdp-error.log
    CustomLog ${APACHE_LOG_DIR}/hmsdp-access.log combined
</VirtualHost>

