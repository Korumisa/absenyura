generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String   @id @default(uuid())
  name                        String
  email                       String   @unique
  password                    String
  role                        String   @default("USER") // SUPER_ADMIN, ADMIN, USER
  avatar_url                  String?
  nim_nip                     String?  @unique
  department                  String?
  phone                       String?
  is_active                   Boolean  @default(true)
  semester                    Int      @default(1)
  enrollment_date             DateTime @default(now())
  device_fingerprint          String?
  refresh_token_hash          String?
  previous_refresh_token_hash String?
  previous_refresh_rotated_at DateTime?
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  created_sessions Session[]       @relation("CreatedSessions")
  attendances      Attendance[]
  excuse_requests  ExcuseRequest[]
  notifications    Notification[]

  lecturer_classes Class[]           @relation("LecturerClasses")
  enrollments      ClassEnrollment[] @relation("StudentEnrollments")
  reviewed_excuses ExcuseRequest[]   @relation("Reviewer")
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  logo_url   String?
  address    String?
  created_at DateTime @default(now())
}

model Class {
  id          String   @id @default(uuid())
  name        String
  semester    Int      @default(1)
  course_code String?
  description String?
  lecturer_id String
  lecturer    User     @relation("LecturerClasses", fields: [lecturer_id], references: [id])
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  enrollments ClassEnrollment[]
  sessions    Session[]
  session_classes SessionClass[]

  @@index([lecturer_id])
}

model ClassEnrollment {
  id          String   @id @default(uuid())
  class_id    String
  class       Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student_id  String
  student     User     @relation("StudentEnrollments", fields: [student_id], references: [id], onDelete: Cascade)
  enrolled_at DateTime @default(now())

  @@unique([class_id, student_id])
  @@index([student_id])
}

model Location {
  id         String   @id @default(uuid())
  name       String
  address    String?
  latitude   Float
  longitude  Float
  radius     Int      @default(100) // in meters
  wifi_bssid String? // JSON array of allowed WiFi BSSID/IP as string
  created_at DateTime @default(now())
  created_by String?

  sessions Session[]
}

model Session {
  id          String  @id @default(uuid())
  title       String
  description String?

  class_id String?
  class    Class?  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  location_id            String
  location               Location @relation(fields: [location_id], references: [id])
  created_by_id          String
  creator                User     @relation("CreatedSessions", fields: [created_by_id], references: [id])
  qr_mode                String   @default("NONE") // DYNAMIC, STATIC, NONE
  qr_token               String?
  qr_secret              String?
  session_start          DateTime
  session_end            DateTime
  check_in_open_at       DateTime
  check_in_close_at      DateTime
  late_threshold_minutes Int      @default(15)
  require_checkout       Boolean  @default(false)
  status                 String   @default("UPCOMING") // UPCOMING, ACTIVE, CLOSED
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  session_classes  SessionClass[]
  attendances     Attendance[]
  excuse_requests ExcuseRequest[]

  @@index([class_id])
  @@index([status, session_start])
  @@index([session_start])
  @@index([created_at])
}

model SessionClass {
  id         String   @id @default(uuid())
  session_id String
  class_id   String
  created_at DateTime @default(now())

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([session_id, class_id])
  @@index([class_id])
}

model Attendance {
  id                  String    @id @default(uuid())
  session_id          String
  session             Session   @relation(fields: [session_id], references: [id])
  user_id             String
  user                User      @relation(fields: [user_id], references: [id])
  check_in_time       DateTime  @default(now())
  check_out_time      DateTime?
  status              String    @default("PRESENT") // PRESENT, LATE, ABSENT
  check_in_lat        Float?
  check_in_lng        Float?
  check_in_accuracy   Float?
  check_in_ip         String?
  check_in_wifi_bssid String?
  check_in_device     String?
  photo_url           String?
  is_manual_entry     Boolean   @default(false)
  manual_entry_note   String?
  manual_entry_by     String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  @@unique([session_id, user_id]) // Prevent double check-in
  @@index([user_id, check_in_time])
  @@index([check_in_time])
  @@index([session_id, check_in_time])
}

model ExcuseRequest {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id])
  session_id  String
  session     Session   @relation(fields: [session_id], references: [id])
  reason      String // SICK, EXCUSED
  description String?
  proof_url   String? // URL of the uploaded proof document/photo
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewed_by String?
  reviewer    User?     @relation("Reviewer", fields: [reviewed_by], references: [id])
  reviewed_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([user_id, session_id])
}

model AuditLog {
  id           String   @id @default(uuid())
  actor_id     String?
  action       String
  target_table String?
  target_id    String?
  old_value    String? // JSON as string
  new_value    String? // JSON as string
  ip_address   String?
  created_at   DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  title      String
  message    String
  type       String   @default("INFO") // INFO, WARNING, SUCCESS
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updated_by  String?
  updated_at  DateTime @updatedAt
}

model ChallengeNonce {
  id         String   @id @default(uuid())
  nonce      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([expires_at])
}

enum PublicPostType {
  BERITA
  KEGIATAN
  LOMBA
  PENGUMUMAN
}

model PublicSiteProfile {
  id               String   @id @default(uuid())
  org_name         String
  campus_name      String
  kabinet_name     String?
  kabinet_period   String?
  hero_subtitle    String?
  home_image_url   String?
  youtube_embed_url String?
  about_title      String?
  about_content    String?
  home_card_left_title  String?
  home_card_left_body   String?
  home_card_right_title String?
  home_card_right_body  String?
  vision           String?
  mission          String?
  visi_photo_url   String?
  visi_name        String?
  visi_role        String?
  misi_photo_url   String?
  misi_name        String?
  misi_role        String?
  footer_tagline   String?
  instagram_url    String?
  tiktok_url       String?
  youtube_url      String?
  address          String?
  email            String?
  phone            String?
  logo_light_url   String?
  logo_dark_url    String?
  primary_color    String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model PublicStructureCabinet {
  id          String   @id @default(uuid())
  name        String
  period      String
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  groups PublicStructureGroup[]

  @@index([is_active, sort_order])
}

model PublicStructureGroup {
  id         String   @id @default(uuid())
  cabinet_id String
  cabinet    PublicStructureCabinet @relation(fields: [cabinet_id], references: [id], onDelete: Cascade)
  title      String
  sort_order Int      @default(0)
  is_core    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  members PublicStructureMember[]
}

model PublicStructureMember {
  id         String   @id @default(uuid())
  group_id   String
  group      PublicStructureGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  name       String
  role       String
  photo_url  String?
  is_spotlight Boolean @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PublicCategory {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  posts PublicPost[]
}

model PublicPost {
  id              String         @id @default(uuid())
  type            PublicPostType @default(BERITA)
  title           String
  slug            String         @unique
  date_label      String?
  status          String?
  form_url        String?
  excerpt         String?
  content         String?
  cover_image_url String?
  category_id     String?
  category        PublicCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  is_published    Boolean        @default(false)
  published_at    DateTime?
  created_by      String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
}

model PublicProgram {
  id           String   @id @default(uuid())
  title        String
  date_range   String?
  description  String?
  is_published Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model PublicGalleryAlbum {
  id           String   @id @default(uuid())
  title        String
  description  String?
  is_published Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  items PublicGalleryItem[]
}

model PublicGalleryItem {
  id         String   @id @default(uuid())
  album_id   String
  album      PublicGalleryAlbum @relation(fields: [album_id], references: [id], onDelete: Cascade)
  image_url  String
  caption    String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
}

model PublicRecruitment {
  id               String   @id @default(uuid())
  title            String
  date_range       String?
  description      String?
  form_url         String?
  poster_image_url String?
  is_published     Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  committee PublicRecruitmentCommittee[]
  contacts  PublicRecruitmentContact[]
}

model PublicRecruitmentCommittee {
  id             String   @id @default(uuid())
  recruitment_id String
  recruitment    PublicRecruitment @relation(fields: [recruitment_id], references: [id], onDelete: Cascade)
  name           String
  role           String
  sort_order     Int      @default(0)
}

model PublicRecruitmentContact {
  id             String   @id @default(uuid())
  recruitment_id String
  recruitment    PublicRecruitment @relation(fields: [recruitment_id], references: [id], onDelete: Cascade)
  name           String
  contact        String
  sort_order     Int      @default(0)
  created_at     DateTime @default(now())
}
