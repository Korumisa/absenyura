{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/trigger?job=session",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/trigger?job=daily",
      "schedule": "0 2 * * *"
    }
  ],
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "server/**"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
